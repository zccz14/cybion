{
  "manifest_version": 3,
  "name": "Cybion",
  "version": "0.5.2",
  "description": "在任意网页上截图问 Cybion，侧边栏里就是 cybion.ntnl.io 本身。",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "storage",
    "contextMenus",
    "sidePanel",
    "audioCapture"
  ],
  "host_permissions": [
    "https://cybion.ntnl.io/*",
    "https://auth.ntnl.io/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://cybion.ntnl.io/*"
      ],
      "js": [
        "src/sync.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "Cybion"
  },
  "commands": {
    "capture-and-ask": {
      "suggested_key": {
        "default": "Ctrl+Shift+K",
        "mac": "Command+Shift+K"
      },
      "description": "截图并问 Cybion"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "key": "",
  "update_url": "https://cybion.ntnl.io/extensions/updates.xml"
}
