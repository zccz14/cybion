{
  "context": [
    {
      "type": "function",
      "name": "cybion_list_contexts",
      "description": "List top-level Contexts (context_id, name, description) from the controller, including the user's top-level CTX (ctx.ntnl.io) documents when that integration is connected. Content is intentionally omitted; use read_context to read a context and discover its direct children.",
      "parameters": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    },
    {
      "type": "function",
      "name": "cybion_list_workers",
      "description": "List owned and shared Workers (worker_id, label, owner_user_id, access) from the controller. Every Worker tool call must include an exact worker_id from this list; never choose a Worker implicitly. Registered Workers are not necessarily online; availability is checked when a Worker tool is called.",
      "parameters": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    },
    {
      "type": "function",
      "name": "read_context",
      "description": "Read the full content of a context and its direct children metadata (context_id, name, description) from the controller. Start from a context_id listed by cybion_list_contexts; pass a returned child context_id to explore further levels.",
      "parameters": {
        "type": "object",
        "properties": {
          "context_id": {
            "type": "string",
            "description": "Exact context_id from cybion_list_contexts or from children returned by a previous read_context call."
          }
        },
        "required": [
          "context_id"
        ],
        "additionalProperties": false
      }
    }
  ],
  "worker": [
    {
      "type": "function",
      "name": "bash",
      "description": "Run a shell command on the user's selected Worker. To wait before the command runs, set delay_seconds instead of embedding a `sleep`: embedded sleeps count toward Worker call duration and misreport Worker performance.",
      "parameters": {
        "type": "object",
        "properties": {
          "worker_id": {
            "type": "string",
            "description": "Exact worker_id from cybion_list_workers."
          },
          "command": {
            "type": "string"
          },
          "delay_seconds": {
            "type": "integer",
            "minimum": 1,
            "description": "Seconds to wait in the controller before this call starts. Prefer this over a `sleep` command: a shell sleep counts toward Worker call duration and misreports Worker performance."
          },
          "timeout_seconds": {
            "type": "integer",
            "minimum": 1,
            "description": "Seconds to allow the command to run before the Worker kills it, measured from execution start; the delay_seconds wait does not count. Defaults to 600."
          }
        },
        "required": [
          "worker_id",
          "command"
        ],
        "additionalProperties": false
      }
    },
    {
      "type": "function",
      "name": "browser_control",
      "description": "Control an isolated browser on the user's selected Worker. delay_seconds waits in the controller before the action starts.",
      "parameters": {
        "type": "object",
        "properties": {
          "worker_id": {
            "type": "string",
            "description": "Exact worker_id from cybion_list_workers."
          },
          "action": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "selector": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "delay_seconds": {
            "type": "integer",
            "minimum": 1,
            "description": "Seconds to wait in the controller before this call starts."
          }
        },
        "required": [
          "worker_id",
          "action"
        ],
        "additionalProperties": false
      }
    },
    {
      "type": "function",
      "name": "computer_use",
      "description": "Perform a user-device computer action through the selected Worker. delay_seconds waits in the controller before the action starts.",
      "parameters": {
        "type": "object",
        "properties": {
          "worker_id": {
            "type": "string",
            "description": "Exact worker_id from cybion_list_workers."
          },
          "action": {
            "type": "string"
          },
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          },
          "text": {
            "type": "string"
          },
          "delay_seconds": {
            "type": "integer",
            "minimum": 1,
            "description": "Seconds to wait in the controller before this call starts."
          }
        },
        "required": [
          "worker_id",
          "action"
        ],
        "additionalProperties": false
      }
    }
  ],
  "native": {
    "web_search": {
      "type": "web_search"
    },
    "normai_image_generation": {
      "type": "function",
      "name": "normai_image_generation",
      "description": "Generate an image from a text prompt and attach it to this conversation for the user to see. Use it whenever the user asks for a picture, illustration, diagram, or any other visual. Describe the subject, style, colors, and composition fully in the prompt; it always creates a new image and cannot edit existing ones.",
      "parameters": {
        "type": "object",
        "properties": {
          "prompt": {
            "type": "string",
            "description": "Complete description of the image to generate."
          }
        },
        "required": [
          "prompt"
        ],
        "additionalProperties": false
      }
    }
  },
  "custom_tools": {
    "linkit": {
      "title": {
        "en": "Linkit",
        "zh": "Linkit"
      },
      "base_url": "https://linkit.ntnl.io",
      "auth": {
        "scheme": "bearer",
        "secret": {
          "store": "integration_settings",
          "field": "linkit_bot_token"
        }
      },
      "available_when": [
        {
          "store": "integration_settings",
          "field": "linkit_bot_id"
        },
        {
          "store": "integration_settings",
          "field": "linkit_bot_token"
        },
        {
          "store": "integration_settings",
          "field": "linkit_username"
        }
      ],
      "limits": {
        "per_minute": 30
      },
      "tools": [
        {
          "type": "function",
          "name": "linkit_list_conversations",
          "title": {
            "en": "List Linkit conversations",
            "zh": "列出 Linkit 会话"
          },
          "description": "List Linkit conversations visible to the user's Cybion bot (id, title, kind). Use before sending to discover conversation_id.",
          "parameters": {
            "type": "object",
            "properties": {},
            "additionalProperties": false
          },
          "binding": {
            "method": "GET",
            "path": "/api/conversations",
            "effect": "read",
            "result": {
              "projection": {
                "conversations": {
                  "list": "conversations",
                  "pick": {
                    "id": "id",
                    "title": "title",
                    "kind": "kind"
                  }
                }
              }
            }
          }
        },
        {
          "type": "function",
          "name": "linkit_read_messages",
          "title": {
            "en": "Read Linkit messages",
            "zh": "读取 Linkit 消息"
          },
          "description": "Read recent messages of a Linkit conversation the bot belongs to.",
          "parameters": {
            "type": "object",
            "properties": {
              "conversation_id": {
                "type": "string"
              },
              "limit": {
                "type": "integer",
                "minimum": 1,
                "maximum": 50
              }
            },
            "required": [
              "conversation_id"
            ],
            "additionalProperties": false
          },
          "binding": {
            "method": "GET",
            "path": "/api/conversations/{conversation_id}/messages",
            "path_params": [
              "conversation_id"
            ],
            "query": [
              "limit"
            ],
            "effect": "read",
            "result": {
              "projection": {
                "messages": {
                  "list": "messages",
                  "pick": {
                    "id": "id",
                    "sender_id": "sender_id",
                    "body": "body",
                    "created_at": "created_at"
                  }
                }
              }
            }
          }
        },
        {
          "type": "function",
          "name": "linkit_send_message",
          "title": {
            "en": "Send Linkit message",
            "zh": "发送 Linkit 消息"
          },
          "description": "Send a message to a Linkit conversation the bot belongs to. Only use when the user asks to notify someone or send something to Linkit.",
          "parameters": {
            "type": "object",
            "properties": {
              "conversation_id": {
                "type": "string"
              },
              "body": {
                "type": "string"
              },
              "urgent": {
                "type": "boolean"
              }
            },
            "required": [
              "conversation_id",
              "body"
            ],
            "additionalProperties": false
          },
          "binding": {
            "method": "POST",
            "path": "/api/conversations/{conversation_id}/messages",
            "path_params": [
              "conversation_id"
            ],
            "body": [
              "body",
              "urgent"
            ],
            "defaults": {
              "urgent": false
            },
            "body_constants": {
              "attachment_ids": []
            },
            "effect": "send",
            "settlement": {
              "strategy": "mark_then_send"
            },
            "result": {
              "projection": {
                "message_id": "id",
                "conversation_id": "conversation_id"
              }
            }
          }
        },
        {
          "type": "function",
          "name": "linkit_open_direct",
          "title": {
            "en": "Open Linkit direct conversation",
            "zh": "打开 Linkit 私信会话"
          },
          "description": "Get the direct conversation id for a Linkit user (username or UUID). Then send with linkit_send_message.",
          "parameters": {
            "type": "object",
            "properties": {
              "username_or_id": {
                "type": "string"
              }
            },
            "required": [
              "username_or_id"
            ],
            "additionalProperties": false
          },
          "binding": {
            "method": "POST",
            "path": "/api/conversations/direct/{username_or_id}",
            "path_params": [
              "username_or_id"
            ],
            "effect": "send",
            "settlement": {
              "strategy": "mark_then_send"
            },
            "result": {
              "projection": {
                "conversation_id": "id"
              }
            }
          }
        }
      ]
    }
  }
}
